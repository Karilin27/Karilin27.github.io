---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<DefaultLayout title="Contacto">
  <PageHeader
    title="Contacto"
    subtitle="¿Quieres ponerte en contacto conmigo? ¡Hablemos!"
    bgType="gradient"
  />

  <section class="my-16">
    <div class="container">
      <div class="grid grid-cols-1 gap-16 md:grid-cols-2">

        <!-- INFORMACIÓN -->
        <div class="space-content">
          <Heading level="h2">Sobre mí</Heading>

          <p class="text-lg">
            Soy <strong>Kariana Ninoska Rivas Rojas</strong>, estudiante de
            Ingeniería de Sistemas en la
            <Link
              href="https://www.unbosque.edu.co/"
              isExternal
            >
              Universidad El Bosque
            </Link>.
          </p>

          <p>
            Me interesa la tecnología, el desarrollo de software, las bases de
            datos y los sistemas de información. Actualmente estoy fortaleciendo
            mis conocimientos y desarrollando proyectos que me permitan crecer
            académica y profesionalmente.
          </p>

          <p>
            Si quieres conocer más sobre mis proyectos o ponerte en contacto
            conmigo, puedes encontrarme en los siguientes medios.
          </p>
        </div>

        <!-- CONTACTO -->
        <div class="space-content">
          <Heading level="h2">Mis contactos</Heading>

          <!-- EMAIL -->
          <div class="gap-2xs flex items-center">
            <Icon
              aria-hidden="true"
              name="lucide:mail"
              size={24}
              class="flex-shrink-0"
            />
            <p>
              <span class="font-bold">Email:</span>
              <Link href="mailto:krivas@unbosque.edu.co">
                krivas@unbosque.edu.co
              </Link>
            </p>
          </div>

          <!-- WHATSAPP -->
          <div class="gap-2xs flex items-center">
            <Icon
              aria-hidden="true"
              name="lucide:message-circle"
              size={24}
              class="flex-shrink-0"
            />
            <p>
              <span class="font-bold">WhatsApp:</span>
              <Link
                href="https://wa.me/573053990509"
                isExternal
              >
                Escríbeme por WhatsApp
              </Link>
            </p>
          </div>

          <!-- UNIVERSIDAD -->
          <div class="gap-2xs flex items-center">
            <Icon
              aria-hidden="true"
              name="lucide:graduation-cap"
              size={24}
              class="flex-shrink-0"
            />
            <p>
              <span class="font-bold">Universidad:</span>
              <Link
                href="https://www.unbosque.edu.co/"
                isExternal
              >
                Universidad El Bosque
              </Link>
            </p>
          </div>

          <!-- UBICACIÓN -->
          <div class="gap-2xs flex items-center">
            <Icon
              aria-hidden="true"
              name="lucide:map-pin"
              size={24}
              class="flex-shrink-0"
            />
            <p>
              <span class="font-bold">Ubicación:</span>
              Bogotá, Colombia
            </p>
          </div>

          <!-- REDES -->
          <div class="pt-4">
            <Heading level="h3">También puedes encontrarme en</Heading>

            <ul class="flex flex-wrap gap-2">

              <!-- GITHUB -->
              <li>
                <Link
                  href="https://github.com/Karilin27"
                  isButton
                  isExternal
                  hideIcon
                  animateOnHover
                  animationType="boop"
                >
                  <Icon
                    aria-hidden="true"
                    name="lucide:github"
                    size={32}
                  />
                  <span class="sr-only">
                    Visitar mi GitHub
                  </span>
                </Link>
              </li>

              <!-- WHATSAPP -->
              <li>
                <Link
                  href="https://wa.me/573053990509"
                  isButton
                  isExternal
                  hideIcon
                  animateOnHover
                  animationType="boop"
                >
                  <Icon
                    aria-hidden="true"
                    name="lucide:message-circle"
                    size={32}
                  />
                  <span class="sr-only">
                    Contactarme por WhatsApp
                  </span>
                </Link>
              </li>

              <!-- INSTAGRAM -->
              <li>
                <Link
                  href="https://www.instagram.com/karianarivas/"
                  isButton
                  isExternal
                  hideIcon
                  animateOnHover
                  animationType="boop"
                >
                  <Icon
                    aria-hidden="true"
                    name="lucide:instagram"
                    size={32}
                  />
                  <span class="sr-only">
                    Visitar mi Instagram
                  </span>
                </Link>
              </li>

            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>
</DefaultLayout>