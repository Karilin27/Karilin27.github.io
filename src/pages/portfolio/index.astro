
---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading, Card } from 'accessible-astro-components'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
---

<DefaultLayout
  title="Kariana Rivas | Portafolio"
  description="Portafolio académico y personal de Kariana Rivas, estudiante de Ingeniería de Sistemas."
  useTitleTemplate={false}
>
  <section class="py-32">
    <div class="container">
      <p class="text-lg mb-4">
        Home / Portafolio
      </p>

      <Heading level="h1" class="mb-8">
        Mi portafolio
      </Heading>

      <p class="text-2xl max-w-3xl leading-relaxed">
        En este espacio comparto los proyectos que desarrollo
        durante mi formación como estudiante de Ingeniería de Sistemas.
      </p>
    </div>
  </section>

  <section class="py-24">
    <div class="container">
      <Heading level="h2" class="mb-6">
        Mis proyectos
      </Heading>

      {
        projects.length > 0 ? (
          <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
              <Card
                url={'/portfolio/' + project.id}
                headingLevel="h3"
                title={project.data.title}
                footer={'Tecnologías: ' + project.data.tags.join(', ')}
              >
                {project.data.description}
              </Card>
            ))}
          </div>
        ) : (
          <p class="text-xl">
            Próximamente encontrarás aquí mis proyectos académicos.
          </p>
        )
      }
    </div>
  </section>
</DefaultLayout>
